# ── Server ────────────────────────────────────────────────────────────────
# Port for the backend and the softphone UI (http://localhost:3000).
PORT=3000

# Public https URL that reaches this server, e.g. from "ngrok http 3000".
# "npm run setup" writes it here and points your Vobiz application at
# <PUBLIC_URL>/answer and <PUBLIC_URL>/hangup.
PUBLIC_URL=https://your-subdomain.ngrok-free.app

# ── Calls ─────────────────────────────────────────────────────────────────
# A Vobiz number on your account, in E.164 format. It is the caller ID on
# outbound calls, and the number people dial to reach the browser.
CALLER_ID=+15550003333

# ── Vobiz account (access-token login and "npm run setup") ────────────────
# From the Vobiz console dashboard. They stay on this server: the browser
# only ever receives a short-lived token from POST /token.
VOBIZ_AUTH_ID=MA_XXXXXXXX
VOBIZ_AUTH_TOKEN=your_auth_token

# Identity put in the token ("sub"). The browser registers as <JWT_SUB>_<VOBIZ_AUTH_ID>.
JWT_SUB=webrtc-demo

# Token lifetime in seconds (minimum 180, maximum 86400). The SDK renews it before expiry.
JWT_TTL_SECONDS=3600

# The Vobiz application whose Answer URL handles calls made with the token.
# "npm run setup" creates the application and fills this in.
JWT_APP_ID=

# ── Password login (optional) ─────────────────────────────────────────────
# SIP URI of a Vobiz endpoint, if you also want to log in with endpoint
# username and password. Inbound calls ring this and the token identity.
# SIP_ENDPOINT=sip:myusername@registrar.vobiz.ai

# ── Call guard (optional) ─────────────────────────────────────────────────
# Public wss:// URL of the vobiz-call-guard service. When set, every call is forked
# to it with a one-way <Stream> and the guard can warn the protected party mid-call.
# GUARD_WSS_URL=wss://guard.example.com/stream   # or wss://<PUBLIC_URL host>/stream, proxied to GUARD_LOCAL_ADDR
# GUARD_LOCAL_ADDR=127.0.0.1:8090
# GUARD_SHARED_SECRET=change-me                  # must match GUARD_SHARED_SECRET in the guard's .env
# GUARD_STATUS_CALLBACK_URL=https://guard.example.com/stream-status

# ── Fallback (leave at 0) ─────────────────────────────────────────────────
# 1 = sign tokens locally with the same HS256 scheme if the Vobiz token API is unreachable.
JWT_LOCAL_SIGN=0
