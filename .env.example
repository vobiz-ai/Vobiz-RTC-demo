# Your Vobiz phone number (E.164 format).
# This appears as the caller ID on outbound calls.
# Must be an active number in your Vobiz account.
CALLER_ID=+15550003333

# Your SIP Endpoint URI for inbound calls (PSTN -> browser).
# Format: sip:<username>@registrar.vobiz.ai
# Copy this exactly from your Endpoint details page in the Vobiz Dashboard
# under SIP Configuration > SIP URI.
SIP_ENDPOINT=sip:myusername@registrar.vobiz.ai

# ── Access-token (JWT) login ──────────────────────────────────────────────
# Account credentials from the Vobiz Console dashboard. They stay on this server;
# the browser only ever receives a short-lived token from POST /token.
VOBIZ_AUTH_ID=MA_XXXXXXXX
VOBIZ_AUTH_TOKEN=your_auth_token

# Identity embedded in the token ("sub"). The browser registers as <JWT_SUB>_<VOBIZ_AUTH_ID>.
JWT_SUB=webrtc-demo

# Token lifetime in seconds (minimum 180, maximum 86400).
JWT_TTL_SECONDS=3600

# Optional: Vobiz application id to bind the token to. Defaults to the account's default app.
# JWT_APP_ID=16247698731828713

# Temporary: sign tokens locally (same HS256 scheme the Vobiz API uses) if the
# API's JWT/Token route is unavailable. Set to 0 once the API route works for you.
JWT_LOCAL_SIGN=0
